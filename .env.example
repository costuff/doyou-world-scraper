# GitHub Container Registry
GITHUB_REPOSITORY_OWNER=your-github-username

# Port Configuration (change if ports are occupied)
API_PORT=3000          # Backend API port (host:container)
FRONTEND_PORT=8080     # Frontend web port (host:container)

# NAS Configuration
NAS_PATH=/mnt/music

# Timezone
TZ=Europe/Athens

# Watchtower Configuration (optional)
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_CLEANUP=true
