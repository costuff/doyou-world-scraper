{
  "name": "doyou-world-scraper",
  "version": "1.0.0",
  "description": "DoYou World Radio track scraper and downloader",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "cd api && go run $(ls *.go | grep -v _test.go)",
    "dev:frontend": "cd frontend && npm run dev",
    "build:api": "cd api && go build -o ../doyou-api .",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
